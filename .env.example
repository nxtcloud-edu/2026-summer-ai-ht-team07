# .env.example — 이 파일을 .env 로 복사해 사용하세요. (.env 는 커밋되지 않습니다)
#
# 알림 기능은 기본이 dry-run 이라 아래 값이 없어도 데모는 정상 동작합니다.
# 실제 발송을 시연할 때만 채우고, configs/app.yaml 의 alerts.dry_run 을 false 로 바꾸세요.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-demo-account@gmail.com
SMTP_PASSWORD=your-app-password

# 쉼표로 구분한 수신자 목록
ALERT_RECIPIENTS=teammate1@example.com,teammate2@example.com
